# Database
# Host port 5433 (not 5432): a pre-existing local Postgres may already own 5432.
# App runtime uses wep_app (non-superuser, RLS-bound) — migrations use wep.
DATABASE_URL=postgresql+psycopg2://wep_app:wep_app_dev_pw@localhost:5433/wep
# Startup-only (bootstrap_tenants), deliberately bypasses RLS.
SYSTEM_DATABASE_URL=postgresql+psycopg2://wep:wep@localhost:5433/wep

# LLM-assisted Discovery (optional; service degrades to import-only without a key)
# provider: anthropic | openai | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# Only needed for OpenAI-compatible endpoints
LLM_BASE_URL=https://api.openai.com/v1

# Slice 3 PR 3a: the old single global SPEC_API_KEY is gone. Every router
# (genome, files, work-units, spec, census, org) authenticates with a
# per-org X-Spec-Key against org_api_keys — see POST /api/org/keys/rotate.

# Required, no default (Track 2 of the enterprise-readiness roadmap): pgcrypto
# symmetric key for field-level PII encryption (services/pii.py). The app
# refuses to start without this set. Generate a real one per environment —
# never reuse the same value across dev/staging/prod, and never commit it:
#   openssl rand -hex 32
PII_ENCRYPTION_KEY=
